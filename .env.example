# Local files and the SQLite database live here. Defaults to ./data when unset.
APP_STORAGE_ROOT=./data

# Optional override. Only sqlite:/// URLs are accepted.
# DATABASE_URL=sqlite:///./data/workflow.db

ORTHANC_URL=
DICOMWEB_BASE_URL=
OHIF_BASE_URL=
SMART_FHIR_ISSUER=
SMART_CLIENT_ID=
EPIC_BASE_URL=
FHIRCAST_HUB_URL=
DEPLOYMENT_MODE=local

# Open-source report dictation. Leave disabled unless Whisper.cpp and ffmpeg are installed.
STT_PROVIDER=disabled
WHISPER_CPP_BINARY=whisper-cli
WHISPER_CPP_MODEL=
FFMPEG_BINARY=ffmpeg
STT_TIMEOUT_SECONDS=120

# Unified workspace: uvicorn app.oncometra:app
# ONCOMETRA_ADMIN_PASSWORD=at-least-12-characters
# CATALOG_WORKER_MODE=inline
# Use external with: python -m app.catalog_worker
# DEMO_EPHEMERAL=false
# COOKIE_SECURE=false
